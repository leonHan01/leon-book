#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="/Volumes/T7Shield/myproject/leonWeb"
WORK_DIR="/Volumes/T7Shield/myblog"
RUN_DIR="$WORK_DIR/.run"
LOG_FILE="$RUN_DIR/blog.log"
SCREEN_SESSION="leonblog"
FRONTEND_PORT=3000
BLOG_STORAGE_PORT=8787

print_help() {
  cat <<EOF
leonblog - Notebook 36 本地博客服务管理

用法：
  leonblog start              启动博客前端和本地文件存储服务
  leonblog stop               停止博客服务
  leonblog restart            重启博客服务
  leonblog status             查看进程、前端和存储服务状态
  leonblog logs               持续查看最近日志
  leonblog logs --once        只查看最近 200 行日志
  leonblog help               显示帮助

地址：
  博客：http://localhost:${FRONTEND_PORT}/
  存储：http://localhost:${BLOG_STORAGE_PORT}/api/status
  文件目录：${WORK_DIR}
EOF
}

ensure_dirs() {
  mkdir -p "$RUN_DIR"
}

screen_session_ids() {
  screen -ls 2>/dev/null | awk -v suffix=".${SCREEN_SESSION}" \
    'length($1) >= length(suffix) && substr($1, length($1) - length(suffix) + 1) == suffix { print $1 }' || true
}

screen_running() {
  [[ -n "$(screen_session_ids)" ]]
}

stop_service() {
  ensure_dirs
  if screen_running; then
    printf '[INFO] 停止博客服务\n'
    local session_id
    while read -r session_id; do
      [[ -n "$session_id" ]] || continue
      screen -S "$session_id" -X quit >/dev/null 2>&1 || true
    done <<< "$(screen_session_ids)"
    for _ in {1..30}; do
      screen_running || break
      sleep 0.2
    done
  else
    printf '[INFO] 博客服务当前未运行\n'
  fi
}

start_service() {
  ensure_dirs
  if screen_running; then
    printf '[OK] 博客服务已运行\n'
    return 0
  fi
  : > "$LOG_FILE"
  printf '[INFO] 启动博客服务\n'
  local launch_command
  launch_command="cd \"$PROJECT_DIR\" && exec env BLOG_STORAGE_HOST=127.0.0.1 BLOG_STORAGE_PORT=$BLOG_STORAGE_PORT BLOG_WORKDIR=\"$WORK_DIR\" /opt/homebrew/bin/npm run dev -- --hostname 127.0.0.1 --port $FRONTEND_PORT"
  screen -dmS "$SCREEN_SESSION" /bin/zsh -lc "$launch_command >> \"$LOG_FILE\" 2>&1"
  sleep 1
  if ! screen_running; then
    printf '[ERROR] 博客服务启动失败，请运行 leonblog logs --once 查看日志\n' >&2
    return 1
  fi
  printf '[OK] 博客服务已启动\n'
  printf '[OK] 博客地址：http://localhost:%s/\n' "$FRONTEND_PORT"
  printf '[OK] 存储目录：%s\n' "$WORK_DIR"
}

status_service() {
  if screen_running; then
    printf '[OK] 博客服务运行中（screen）\n'
  else
    printf '[STOPPED] 博客服务未运行\n'
  fi
  if curl -fsS --max-time 2 "http://localhost:${FRONTEND_PORT}/" >/dev/null 2>&1; then
    printf '[OK] 前端可访问：http://localhost:%s/\n' "$FRONTEND_PORT"
  else
    printf '[DOWN] 前端不可访问：http://localhost:%s/\n' "$FRONTEND_PORT"
  fi
  if curl -fsS --max-time 2 "http://localhost:${BLOG_STORAGE_PORT}/api/status" >/dev/null 2>&1; then
    printf '[OK] 本地存储服务运行中：http://localhost:%s/\n' "$BLOG_STORAGE_PORT"
  else
    printf '[DOWN] 本地存储服务不可访问：http://localhost:%s/\n' "$BLOG_STORAGE_PORT"
  fi
}

logs_service() {
  ensure_dirs
  [[ -f "$LOG_FILE" ]] || { printf '[ERROR] 暂无日志，请先执行 leonblog start\n' >&2; return 1; }
  if [[ "${1:-}" == "--once" ]]; then
    tail -n 200 "$LOG_FILE"
  else
    tail -n 120 -f "$LOG_FILE"
  fi
}

command_name="${1:-help}"
case "$command_name" in
  start) start_service ;;
  stop) stop_service ;;
  restart) stop_service; start_service ;;
  status) status_service ;;
  logs) logs_service "${2:-}" ;;
  help|-h|--help) print_help ;;
  *) printf '[ERROR] 未知命令：%s\n\n' "$command_name" >&2; print_help >&2; exit 2 ;;
esac
