#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
PROJECT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
MACOS_APP="$PROJECT_DIR/macos/dist/leon-book.app"
MACOS_EXECUTABLE="$MACOS_APP/Contents/MacOS/LeonBook"

print_help() {
  cat <<EOF
leonblog - leon-book 原生 macOS 应用管理

用法：
  leonblog open               构建过期版本后打开原生 leon-book 应用
  leonblog start              与 open 相同
  leonblog build              构建原生应用
  leonblog test               运行原生应用检查
  leonblog help               显示帮助

数据位置：
  \$LEON_BOOK_WORKDIR（若已设置）
  /Volumes/T7Shield/myblog（默认）

若要使用其他目录，打开前请设置：
  LEON_BOOK_WORKDIR=/Volumes/T7Shield/myblog ./scripts/leonblog open
EOF
}

build_native_app() {
  "$PROJECT_DIR/macos/scripts/build-app.sh"
}

native_app_needs_build() {
  [[ ! -x "$MACOS_EXECUTABLE" ]] && return 0

  local input
  local build_inputs=(
    "$PROJECT_DIR/macos/Package.swift"
    "$PROJECT_DIR/macos/Resources"
    "$PROJECT_DIR/macos/Sources"
    "$PROJECT_DIR/macos/scripts/build-app.sh"
  )
  for input in "${build_inputs[@]}"; do
    [[ "$input" -nt "$MACOS_EXECUTABLE" ]] && return 0
  done

  find "$PROJECT_DIR/macos/Sources" "$PROJECT_DIR/macos/Resources" \
    -type f -newer "$MACOS_EXECUTABLE" -print -quit | /usr/bin/grep -q .
}

open_native_app() {
  local rebuilt=0
  if native_app_needs_build; then
    printf '[INFO] 原生应用缺失或已过期，正在构建…\n'
    build_native_app
    rebuilt=1
  else
    printf '[INFO] 原生应用已是最新版本，无需构建。\n'
  fi

  if [[ "$rebuilt" -eq 1 ]] && pgrep -x LeonBook >/dev/null; then
    printf '[WARN] 已构建新版本，但当前 leon-book 仍在运行。请先在应用中保存并手动退出，再重新执行 leonblog open 以载入新版本。\n'
    return 0
  fi

  printf '[INFO] 打开原生 leon-book 应用\n'
  if [[ -n "${LEON_BOOK_WORKDIR:-}" ]]; then
    open --env "LEON_BOOK_WORKDIR=${LEON_BOOK_WORKDIR}" "$MACOS_APP"
  else
    open "$MACOS_APP"
  fi
}

command_name="${1:-help}"
case "$command_name" in
  open|start) open_native_app ;;
  build) build_native_app ;;
  test) "$PROJECT_DIR/macos/scripts/test-app.sh" ;;
  help|-h|--help) print_help ;;
  *) printf '[ERROR] 未知命令：%s\n\n' "$command_name" >&2; print_help >&2; exit 2 ;;
esac
