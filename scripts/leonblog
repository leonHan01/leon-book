#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
PROJECT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
MACOS_APP="$PROJECT_DIR/macos/dist/leon-book.app"
MACOS_EXECUTABLE="$MACOS_APP/Contents/MacOS/LeonBook"
MACOS_PROCESS_NAME="LeonBook"
MACOS_BUNDLE_IDENTIFIER="com.leon-book.macos"
MACOS_BUILD_INFO="$MACOS_APP/Contents/Resources/leonbook-build-configuration"
MACOS_BUILD_SYSTEM_INFO="$MACOS_APP/Contents/Resources/leonbook-build-system"

print_help() {
  cat <<EOF
leonblog - leon-book 原生 macOS 应用管理

用法：
  leonblog open               构建过期版本后打开原生 leon-book 应用
  leonblog start              与 open 相同
  leonblog restart            关闭当前应用，仅在版本过期时构建后启动
  leonblog restart --release  使用 Release 优化构建后重启
  leonblog build              构建 Release 原生应用
  leonblog test               运行原生应用检查
  leonblog coverage           运行单元测试并生成覆盖率报告
  leonblog api METHOD [...]   外部 AI JSON CLI（api capabilities 列出所有能力）
  leonblog api --stdio        JSON Lines 接口，每行一个请求和响应
  leonblog help               显示帮助

构建模式：
  restart 默认使用 Debug 增量构建，build 默认使用 Release。
  open / start 沿用已安装版本的模式，首次构建使用 Debug。
  上述命令可用 --debug / --release 切换模式；首次使用某模式需要完整编译。
  Debug 默认使用 native 引擎；LEON_BOOK_BUILD_SYSTEM=default 可切回工具链默认引擎。

数据位置：
  \$LEON_BOOK_WORKDIR（若已设置）
  /Volumes/T7Shield/myblog（默认）

若要使用其他目录，打开前请设置：
  LEON_BOOK_WORKDIR=/Volumes/T7Shield/myblog ./scripts/leonblog open
EOF
}

build_native_app() {
  LEON_BOOK_BUILD_CONFIGURATION="$BUILD_CONFIGURATION" LEON_BOOK_BUILD_SYSTEM="$BUILD_SYSTEM" \
    "$PROJECT_DIR/macos/scripts/build-app.sh"
}

native_app_needs_build() {
  [[ ! -x "$MACOS_EXECUTABLE" ]] && return 0
  [[ ! -x "$MACOS_APP/Contents/MacOS/LeonBookCLI" ]] && return 0
  [[ ! -d "$MACOS_APP/Contents/Resources/LeonBookMac_LeonBook.bundle" ]] && return 0
  [[ ! -f "$MACOS_BUILD_INFO" ]] && return 0
  [[ "$(cat "$MACOS_BUILD_INFO")" != "$BUILD_CONFIGURATION" ]] && return 0
  [[ ! -f "$MACOS_BUILD_SYSTEM_INFO" ]] && return 0
  [[ "$(cat "$MACOS_BUILD_SYSTEM_INFO")" != "$BUILD_SYSTEM" ]] && return 0

  local input
  local build_inputs=(
    "$PROJECT_DIR/macos/Package.swift"
    "$PROJECT_DIR/macos/Package.resolved"
    "$PROJECT_DIR/macos/Resources"
    "$PROJECT_DIR/macos/Sources"
    "$PROJECT_DIR/macos/scripts/build-app.sh"
    "$PROJECT_DIR/macos/scripts/swift-sdk.sh"
  )
  for input in "${build_inputs[@]}"; do
    [[ "$input" -nt "$MACOS_BUILD_INFO" ]] && return 0
  done

  find "$PROJECT_DIR/macos/Sources" "$PROJECT_DIR/macos/Resources" \
    -newer "$MACOS_BUILD_INFO" -print -quit | /usr/bin/grep -q .
}

launch_native_app() {
  printf '[INFO] 打开原生 leon-book 应用\n'
  if [[ -n "${LEON_BOOK_WORKDIR:-}" ]]; then
    open --env "LEON_BOOK_WORKDIR=${LEON_BOOK_WORKDIR}" "$MACOS_APP"
  else
    open "$MACOS_APP"
  fi
}

wait_for_native_app_exit() {
  local remaining_attempts=40
  while pgrep -x "$MACOS_PROCESS_NAME" >/dev/null; do
    if [[ "$remaining_attempts" -le 0 ]]; then
      return 1
    fi
    sleep 0.25
    remaining_attempts=$((remaining_attempts - 1))
  done
}

quit_native_app() {
  if ! pgrep -x "$MACOS_PROCESS_NAME" >/dev/null; then
    printf '[INFO] 当前 leon-book 应用未运行。\n'
    return 0
  fi

  printf '[INFO] 正在关闭当前 leon-book 应用…\n'
  if ! osascript -e "tell application id \"$MACOS_BUNDLE_IDENTIFIER\" to quit"; then
    printf '[ERROR] 无法请求 leon-book 退出。\n' >&2
    return 1
  fi
  if ! wait_for_native_app_exit; then
    printf '[ERROR] leon-book 在 10 秒内未退出；已取消重新构建，请处理未保存内容或退出确认后重试。\n' >&2
    return 1
  fi
  printf '[INFO] leon-book 已关闭。\n'
}

restart_native_app() {
  local started_at=$SECONDS
  quit_native_app
  open_native_app
  printf '[INFO] 重启完成（耗时 %s 秒）。\n' "$((SECONDS - started_at))"
}

open_native_app() {
  local rebuilt=0
  if native_app_needs_build; then
    printf '[INFO] 原生应用缺失或已过期，正在构建…\n'
    build_native_app
    rebuilt=1
  else
    printf '[INFO] 原生应用已是最新版本，无需构建。\n'
  fi

  if [[ "$rebuilt" -eq 1 ]] && pgrep -x "$MACOS_PROCESS_NAME" >/dev/null; then
    printf '[WARN] 已构建新版本，但当前 leon-book 仍在运行。请先在应用中保存并手动退出，再重新执行 leonblog open 以载入新版本。\n'
    return 0
  fi

  launch_native_app
}

command_name="${1:-help}"
case "$command_name" in
  open|start|restart|build)
    REUSE_INSTALLED_BUILD=0
    if [[ "$command_name" == build ]]; then
      BUILD_CONFIGURATION=release
    else
      BUILD_CONFIGURATION=debug
      if [[ "$command_name" != restart && -f "$MACOS_BUILD_INFO" ]]; then
        BUILD_CONFIGURATION="$(cat "$MACOS_BUILD_INFO")"
        if [[ $# -eq 1 && -z "${LEON_BOOK_BUILD_CONFIGURATION:-}" ]]; then
          REUSE_INSTALLED_BUILD=1
        fi
      fi
    fi
    BUILD_CONFIGURATION="${LEON_BOOK_BUILD_CONFIGURATION:-$BUILD_CONFIGURATION}"
    shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --debug) BUILD_CONFIGURATION=debug ;;
        --release) BUILD_CONFIGURATION=release ;;
        *) printf '[ERROR] 未知构建选项：%s\n' "$1" >&2; exit 2 ;;
      esac
      shift
    done
    case "$BUILD_CONFIGURATION" in
      debug|release) ;;
      *) printf '[ERROR] 无效构建模式：%s（应为 debug 或 release）。\n' "$BUILD_CONFIGURATION" >&2; exit 2 ;;
    esac
    BUILD_SYSTEM="${LEON_BOOK_BUILD_SYSTEM:-}"
    if [[ -z "$BUILD_SYSTEM" ]]; then
      if [[ "$REUSE_INSTALLED_BUILD" -eq 1 && -f "$MACOS_BUILD_SYSTEM_INFO" ]]; then
        BUILD_SYSTEM="$(cat "$MACOS_BUILD_SYSTEM_INFO")"
      elif [[ "$BUILD_CONFIGURATION" == debug ]]; then
        BUILD_SYSTEM=native
      else
        BUILD_SYSTEM=default
      fi
    fi
    if [[ "$BUILD_SYSTEM" == native && -z "${LEON_BOOK_BUILD_SYSTEM:-}" ]] && \
      ! swift build --help 2>/dev/null | /usr/bin/grep -E '^[[:space:]]+native[[:space:]]+-' >/dev/null; then
      BUILD_SYSTEM=default
    fi
    case "$BUILD_SYSTEM" in
      default|native|swiftbuild) ;;
      *) printf '[ERROR] 无效构建引擎：%s（应为 default、native 或 swiftbuild）。\n' "$BUILD_SYSTEM" >&2; exit 2 ;;
    esac
    ;;
esac
case "$command_name" in
  open|start) open_native_app ;;
  restart) restart_native_app ;;
  build) build_native_app ;;
  test) "$PROJECT_DIR/macos/scripts/test-app.sh" ;;
  coverage) "$PROJECT_DIR/macos/scripts/coverage.sh" ;;
  api) shift; exec /bin/zsh "$PROJECT_DIR/macos/scripts/run-cli.sh" "$@" ;;
  help|-h|--help) print_help ;;
  *) printf '[ERROR] 未知命令：%s\n\n' "$command_name" >&2; print_help >&2; exit 2 ;;
esac
