# Comma-separated `oai-authenticated-user-id` values allowed to manage the blog.
# Production writes stay disabled until this value is configured by the host.
BLOG_AUTHOR_USER_IDS=

# Optional comma-separated author emails. Sites injects the authenticated email
# server-side; this is useful when the site-scoped user ID is not yet known.
BLOG_AUTHOR_EMAILS=

# Local development only. vite.config.ts supplies this automatically; never set
# it on a deployed site.
BLOG_ALLOW_LOCAL_WRITES=false
