.DS_Store
._*
Thumbs.db
.AppleDouble
.LSOverride
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# JavaScript tooling, if used by local scripts
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
