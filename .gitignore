# Swift Package Manager and native build output
.build/
macos/.build*/
.swiftpm/
macos/.swiftpm-*/
macos/dist/
DerivedData/
build/

# Xcode user-specific data
*.xcuserstate
*.xcscmblueprint
xcuserdata/

# Logs and temporary files
*.log
*.tmp
*.temp

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.p12

# Legacy source-art archive, not used by the native application
/leon_workflow-assets/

